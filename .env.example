# Dot 设备 API 密钥（从 Dot. App 获取，或复制参考项目 quote0-deepseek-balance/.env）
DOT_API_KEY=dot_app_xxxx
DOT_DEVICE_ID=xxxx

# 推送模式：image（Image API 整卡 PNG，默认）| canvas（Canvas API DSL）
PUSH_MODE=image

# 表情包二值化：bw（硬阈值，默认）| fs（Floyd-Steinberg）| 4level（四级灰阶）
TREATMENT=bw

# 表情包来源：random（默认，按周几从 pic/周一周二等分组文件夹随机抽）
#            | fixed（固定顶层单日文件 pic/周一.GIF）
MEME_MODE=random
